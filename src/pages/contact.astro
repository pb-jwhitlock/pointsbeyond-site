---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/config';
---

<Layout
  title="Contact Points Beyond AI — Book a Free Strategy Call"
  description="Book a free 30-minute strategy call with Points Beyond AI. We'll map where your business is losing leads and show you what AI can fix."
>

  <!-- Booking Calendar -->
  <section class="section booking-section">
    <div class="container booking-inner">

      <div class="booking-header">
        <p class="section-eyebrow">Book a Call</p>
        <h1 class="booking-headline">Free 30-minute strategy call.</h1>
        <p class="booking-intro">Pick a time that works for you. We'll map your current lead flow, identify where calls and reviews are slipping, and walk you through exactly what we'd build — no obligation, no pitch deck.</p>
      </div>

      <div class="calendar-slot">
        <iframe
          src="https://link.agency-vault.com/widget/bookings/points-beyond-ai"
          style="width:100%;border:none;overflow:hidden;"
          scrolling="no"
          id="msgsndr-calendar"
        ></iframe>
        <script src="https://link.agency-vault.com/js/form_embed.js" type="text/javascript"></script>
      </div>

    </div>
  </section>


</Layout>

<style>
  .booking-inner {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 5rem;
    align-items: start;
  }

  .booking-header {
    position: sticky;
    top: 6rem;
  }

  .section-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
    max-width: none;
  }

  .booking-headline {
    font-size: clamp(28px, 3.5vw, 46px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .booking-intro {
    font-size: 0.975rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 36ch;
  }

  .calendar-slot {
    min-height: 300px;
  }

  .section-divider {
    height: 1px;
    background: var(--color-border);
    padding: 0;
  }

  @media (max-width: 960px) {
    .booking-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .booking-header {
      position: static;
    }

    .booking-intro {
      max-width: 60ch;
    }
  }
</style>
