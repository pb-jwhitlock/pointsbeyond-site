---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ, { faqs } from '../components/FAQ.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a,
    },
  })),
};
---

<Layout
  title="Points Beyond AI — AI Agents & Voice AI for Small Business"
  description="Points Beyond AI builds autonomous AI agents that answer every call, generate reviews, and get your business cited by ChatGPT and Perplexity. Fairfax County, VA."
  schema={faqSchema}
>
  <Hero />
  <PainPoints />
  <Services />
  <Process />
  <Testimonials />
  <FAQ />
  {/* SMS opt-in is /contact/ chat widget only (A2P-registered). New forms here are fine if they don't collect phone for SMS — e.g. email-only signups, calendar booking via Calendly/AV calendar are OK. */}
  <section class="section" id="contact">
    <div class="container" style="display:grid;grid-template-columns:280px 1fr;gap:4rem;align-items:start;">
      <div style="position:sticky;top:6rem;">
        <p style="font-size:0.8rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-accent);margin-bottom:1.25rem;">Get Started</p>
        <h2 style="font-size:clamp(26px,3vw,42px);font-weight:800;line-height:1.2;letter-spacing:-0.025em;color:var(--color-text);">Ready to capture every lead?</h2>
      </div>
      <div>
        <p class="section-body" style="margin-bottom:2rem;">Book a free 30-minute strategy call — we'll map your lead flow, show you what AI would fix, and give you a clear plan. No pitch, no pressure.</p>
        <a href="/contact/" class="btn-primary">Book My Free Strategy Call →</a>
      </div>
    </div>
  </section>
</Layout>
